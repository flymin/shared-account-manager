ARG IMAGE_PREFIX=
FROM ${IMAGE_PREFIX}node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package*.json ./
COPY deploy/build-ca.* /opt/build-ca/
RUN if [ -f /opt/build-ca/build-ca.pem ]; then export NODE_EXTRA_CA_CERTS=/opt/build-ca/build-ca.pem; fi; npm ci
COPY frontend/ ./
RUN npm run build
FROM ${IMAGE_PREFIX}nginx:1.28-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
