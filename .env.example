# Optional Docker Hub cache prefix, including its trailing slash.
IMAGE_PREFIX=
BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080
# External origin when using a reverse proxy, e.g. https://accounts.example.test
# HTTPS also enables Secure session cookies. Leave empty for direct local HTTP.
PUBLIC_ORIGIN=
# Optional TOML tool catalog; relative paths are resolved from deploy/.
# Example: ../.local/mail-tools.toml. Empty uses the bundled catalog.
MAIL_TOOLS_CONFIG_PATH=
# Six-digit email code matching rules. Both values are required to enable this template.
# Use the exact sender address and a stable product/service token in the subject.
# Example values: noreply@login.example.test and ExampleService.
MAIL_CODE_SENDER=
MAIL_CODE_SUBJECT_KEYWORD=
